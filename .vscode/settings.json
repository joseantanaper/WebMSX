{
  "launch": {
    "configurations": [
      {
        "name": "Launch Chrome (localhost:5173)",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder}/src/runtimerf"
      }
    ],
    "compounds": [
      {
        "name": "Full Stack: Dev Server + Chrome",
        "configurations": ["Launch Chrome (localhost:5173)"],
        "preLaunchTask": "npm: dev"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "npm: dev",
        "type": "npm",
        "script": "dev",
        "isBackground": true
      }
    ]
  },
  "npm.autoDetect": "on",
  "npm.enableScriptExplorer": true,
  "terminal.integrated.env.linux": {
    "BROWSER": "none"
  }
}
